{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./*"],
      "@workspace/ui/components/*": ["./components/ui/*"],
      "@workspace/ui/lib/*": ["./lib/*"],
      "@workspace/ui/*": ["./components/ui/*"],
      "@tanstack/react-router": ["./lib/router-shim.ts"],
      "motion/react": ["./node_modules/framer-motion"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": ["supabase", "dist", "node_modules", "repo-csl-system", "repo-gesit-erp"]
}